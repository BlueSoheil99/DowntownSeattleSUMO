<configuration>
    <input>
        <net-file value="GTFS/soheil_seattle_merged_pedspeed.net.xml"/>


        <additional-files value="clean corrected inputs/forMFD_Taz_with_pseudo.add.xml,
        edge_data.add.xml,
        edge_data_min.add.xml,
        edge_data_150.add.xml,
        clean corrected inputs/correct_Alaskan_new_signal_additional_columbia_eb.add.xml,
        validation_loop_detectors.add.xml,
                GTFS/rail/tram.add.xml,
                GTFS/rail/gtfs_pt_stops.add.xml,
                GTFS/rail/gtfs_pt_vehicles.add.xml,
                GTFS/bus/bus.add.xml,
                GTFS/bus/gtfs_pt_stops.add.xml,
                GTFS/bus/gtfs_pt_vehicles.add.xml"/>


        <!-- bus riders from ridership/ridership_personflows.py (2025 Q3 ridership, AM + MID, all 40 downtown lines) -->
        <route-files value= "adjusted_alaskanway_od2trips_psrc_vehicle_trips_converted_taz_calibrated_V3.rou.xml,
                             ridership/kcm_riders_253_AM_MID.rou.xml"/>

<!--        older person flows (ridership_generation.py, routes 24/33/70/8 only), kept for reference:
            <route-files value= "adjusted_alaskanway_od2trips_psrc_vehicle_trips_converted_taz_calibrated_V3.rou.xml,
                             ridership/kcm_personflows_253_AM_with_alighting.rou.xml"/>-->
<!--        <route-files value= "ridership/kcm_personflows_253_AM_with_alighting.rou.xml"/>-->

    </input>

    <output>
        <tripinfo-output value="new output/tripinfo_output.xml"/>
        <vehroute-output value="new output/vehroute_output.xml"/>
    </output>

    <time>
        <begin value="18000"/>
        <end value="43200"/>
        <step-length value="0.1"/>
    </time>

    <processing>
        <extrapolate-departpos value="true"/>
        <!-- single-threaded: with the bus riders, threads 4 made SUMO 1.28 crash, hang or write corrupted output -->
        <threads value="1"/>
        <ignore-junction-blocker value="60"/>
        <ignore-route-errors value="true"/>
        <ignore-accidents value="true"/>
        <collision.action value="remove"/>
        <time-to-teleport value="150"/>
        <sloppy-insert value="true"/>
        <lanechange.overtake-right value="true"/>
    </processing>

    <routing>
        <routing-algorithm value="astar"/>
		<weights.priority-factor value="10" />
        <device.rerouting.probability value="0.7"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.with-taz value="true"/>
        <!-- pre-period 0: don't reroute cars while they wait to be inserted (SUMO default: every 60 s).
             REQUIRED: without it, runs with the car demand crash (segfault, no SUMO error) between about 07:13 and 08:11.
             Cause (SUMO bug): a TAZ trip (fromTaz only) waiting to be inserted is rerouted, with-taz gives it a route
             starting on a different source edge of the TAZ, but SUMO still inserts it on the old edge; two such cars crash SUMO.
             With pre-period 0 the full 05:00-12:00 run finishes (lab server, 2026-10-20); car results are nearly unchanged. -->
        <device.rerouting.pre-period value="0"/>
        <device.rerouting.threads value="0"/>
    </routing>

    <report>
        <log value="new output/log.xml"/>
    </report>

</configuration>
