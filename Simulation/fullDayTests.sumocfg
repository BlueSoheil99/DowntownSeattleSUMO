<configuration>
    <input>
        <net-file value="clean corrected inputs/correct_Alaskan_offset_signal_Seattle_network_reformed connections2.net.xml"/>
<!--        <route-files value="fullDay tests/adjusted_alaskanway_od2trips_psrc_vehicle_trips_converted_taz_calibrated_onlyDowntown_fullDay.rou.xml"/>-->
        <route-files value="fullDay tests/reduced_80percent_of_adjusted_alaskanway_od2trips_psrc_vehicle_trips_converted_taz_calibrated_onlyDowntown_fullDay.rou.xml"/>
        <additional-files value="clean corrected inputs/forMFD_Taz_with_pseudo.add.xml,fullDay tests/edge_data.add.xml, fullDay tests/edge_data_min.add.xml,clean corrected inputs/correct_Alaskan_new_signal_additional.add.xml, fullDay tests/validation_loop_detectors.add.xml"/>
    </input>

    <output>
        <tripinfo-output value="fullDay tests/out/tripinfo_output.xml"/>
        <vehroute-output value="fullDay tests/out/vehroute_output.xml"/>
    </output>

    <time>
        <begin value="0"/>
        <end value="93600"/>
        <step-length value="0.1"/>
    </time>

    <processing>
        <extrapolate-departpos value="true"/>
        <threads value="4"/>
        <ignore-junction-blocker value="60"/>
        <ignore-route-errors value="true"/>
        <ignore-accidents value="true"/>
        <collision.action value="remove"/>
        <time-to-teleport value="150"/>
        <sloppy-insert value="true"/>
        <lanechange.overtake-right value="true"/>
    </processing>

    <routing>
        <routing-algorithm value="astar"/>
		<weights.priority-factor value="10" />
        <device.rerouting.probability value="0.7"/>
        <device.rerouting.period value="300"/>
        <device.rerouting.with-taz value="true"/>
        <device.rerouting.threads value="4"/>
    </routing>

    <report>
        <log value="fullDay tests/out/log.xml"/>
    </report>

</configuration>
